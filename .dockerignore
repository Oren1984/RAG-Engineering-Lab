# Version control
.git
.gitignore

# AI assistant workspace
.claude/

# Secrets — never bake into image
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
tests/

# Internal project material — not required at runtime
prompts/
notebooks/
docs/

# Runtime-generated data
vector_db/chroma/*
vector_db/faiss/*
results/*
data/raw/*
data/processed/*

# Keep required placeholders and source data
!vector_db/chroma/.gitkeep
!vector_db/faiss/.gitkeep
!results/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Build and packaging
dist/
build/
*.egg-info/
.eggs/

# Editor and OS artifacts
.vscode/
.idea/
.DS_Store
._*
Thumbs.db
desktop.ini
*.swp
*.swo
*~

